PORT=5001
NODE_ENV=development
JWT_SECRET=wheelwash_super_secret_jwt_key_2026_mcd_production
JWT_EXPIRES_IN=24h
EXCEL_DB_PATH=./public/database.xlsx

# Google Sheet database (optional). Paste the Web app URL of google-apps-script.js to keep all
# data in a Google Sheet; the Excel file above then only acts as a local cache.
GOOGLE_SCRIPT_URL=
# Must match SECRET_KEY in the Apps Script (leave both empty to not use a secret)
GOOGLE_SCRIPT_SECRET=
CORS_ORIGIN=http://localhost:5173
DEMO_MODE=true
TIMEZONE=Asia/Kolkata
FFMPEG_PATH=ffmpeg

# YOLO26 truck-vs-human detector (backend/yolo/detect_server.py)
YOLO_URL=http://127.0.0.1:5002
YOLO_AUTOSTART=true
YOLO_PYTHON=python3
YOLO_VEHICLE_CLASSES=truck,bus
YOLO_TRUCK_MIN_CONF=0.45
YOLO_PERSON_MIN_CONF=0.35
